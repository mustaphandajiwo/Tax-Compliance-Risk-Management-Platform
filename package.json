{
  "name": "ngsirs-crm-platform",
  "private": true,
  "description": "NGSIRS Compliance Risk Management Platform - JavaScript workspace (web console, contracts, design)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "gen:api": "pnpm --filter @ngsirs/contracts gen:api",
    "dev": "pnpm --filter @ngsirs/web dev",
    "build": "pnpm --filter @ngsirs/web build",
    "start": "pnpm --filter @ngsirs/web start",
    "lint": "pnpm --filter @ngsirs/web lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @ngsirs/e2e test"
  }
}
