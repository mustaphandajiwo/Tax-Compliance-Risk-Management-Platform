{
  "name": "taxrisk-platform",
  "private": true,
  "description": "Tax Compliance Risk Platform - JavaScript workspace (web console, contracts, design)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "gen:api": "pnpm --filter @taxrisk/contracts gen:api",
    "dev": "pnpm --filter @taxrisk/web dev",
    "build": "pnpm --filter @taxrisk/web build",
    "start": "pnpm --filter @taxrisk/web start",
    "lint": "pnpm --filter @taxrisk/web lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @taxrisk/e2e test"
  }
}
