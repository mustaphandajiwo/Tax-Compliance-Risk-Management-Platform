[
  {
    "id": "FIL-001", "version": "1.0.0", "domain": "filing",
    "title": "PAYE accepted employer return missing for verified period",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_MONTHLY_RETURN@effective_period",
    "eligibility": ["active_obligation", "past_return_due_date"],
    "input_refs": ["period_schedule", "return_filing", "tax_obligation", "extension"],
    "conditions": [{"field": "accepted_filing_count", "op": "eq", "value": 0}],
    "exclusions": ["approved_extension", "ceased_obligation", "processing_delay", "source_conflict", "filing_coverage_incomplete", "quarantined_period_records"],
    "holds": ["legal_hold", "disputed", "extension_undecided"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["filing"]},
    "signal": {
      "likelihood": {"base": 3, "adjust": [{"when": [{"aggregate": "count", "series": "filing", "window": 6, "where": [{"field": "missing", "op": "eq", "value": true}], "op": "gte", "value": 3}], "add": 1}]},
      "consequence": "unknown", "effort": "low"
    },
    "treatment": "review_then_approved_reminder",
    "explanation": "No accepted PAYE employer return found for verified obligation period {period} after effective due date {return_due_at}.",
    "alternative_explanations": [
      "Return filed through a channel whose extract is not yet ingested",
      "Employer ceased operating or ceased having employees but cessation is unrecorded",
      "An extension or exemption exists that has not been captured"
    ],
    "references": ["SYNTHETIC: state-approved effective-dated PAYE return provision (pending NGSIRS legal confirmation)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
    "id": "FIL-002", "version": "1.0.0", "domain": "filing",
    "title": "PAYE return accepted after legally configured due date",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_MONTHLY_RETURN@effective_period",
    "eligibility": ["active_obligation", "accepted_return_exists"],
    "input_refs": ["period_schedule", "return_filing", "extension"],
    "conditions": [{"field": "filing_late_days", "op": "gt", "value": 0}],
    "exclusions": ["source_conflict", "filing_coverage_incomplete"],
    "holds": ["legal_hold", "disputed"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["filing"]},
    "signal": {
      "likelihood": {"base": 2, "adjust": [{"when": [{"aggregate": "count", "series": "filing", "window": 6, "where": [{"field": "late", "op": "eq", "value": true}], "op": "gte", "value": 3}], "add": 1}]},
      "consequence": "unknown", "effort": "low"
    },
    "treatment": "targeted_assistance",
    "explanation": "PAYE return for {period} accepted {filing_late_days} day(s) after the effective due date {return_due_at}.",
    "alternative_explanations": ["Submission made on time but accepted late due to processing backlog", "Portal incident near due date"],
    "references": ["SYNTHETIC: state-approved effective-dated PAYE return provision (pending NGSIRS legal confirmation)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
    "id": "FIL-003", "version": "1.0.0", "domain": "filing",
    "title": "Repeated verified PAYE missing returns",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_MONTHLY_RETURN@effective_period",
    "eligibility": ["active_obligation"],
    "input_refs": ["period_schedule", "return_filing", "tax_obligation"],
    "conditions": [
      {"field": "anchor_period", "op": "eq", "value": true},
      {"aggregate": "count", "series": "filing", "window": 6, "where": [{"field": "eligible", "op": "eq", "value": true}, {"field": "missing", "op": "eq", "value": true}], "op": "gte", "value": 3}
    ],
    "exclusions": ["ceased_obligation", "source_conflict", "filing_coverage_incomplete", "quarantined_period_records"],
    "holds": ["legal_hold", "disputed"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["filing"]},
    "signal": {"likelihood": {"base": 4, "adjust": []}, "consequence": "unknown", "effort": "medium"},
    "treatment": "compliance_engagement",
    "explanation": "Three or more eligible PAYE return periods in the last six are missing as at {period}.",
    "alternative_explanations": ["Employer has ceased trading but cessation is unrecorded", "Returns filed under a different, unlinked identity"],
    "references": ["SYNTHETIC: state-approved effective-dated PAYE return provision (pending NGSIRS legal confirmation)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
    "id": "PAY-001", "version": "1.0.0", "domain": "payment",
    "title": "PAYE remittance missing on settled due period",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_REMITTANCE@effective_period",
    "eligibility": ["active_obligation", "past_payment_due_date"],
    "input_refs": ["period_schedule", "payment", "payment_allocation", "return_filing"],
    "conditions": [{"field": "settled_payment_count", "op": "eq", "value": 0}],
    "exclusions": ["ceased_obligation", "payment_coverage_incomplete", "possible_unallocated_receipt", "quarantined_period_records", "source_conflict", "bank_delay_dispute"],
    "holds": ["legal_hold", "disputed", "reversal_unconfirmed"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["payment"]},
    "signal": {
      "likelihood": {"base": 3, "adjust": [{"when": [{"aggregate": "count", "series": "payment", "window": 6, "where": [{"field": "missing", "op": "eq", "value": true}], "op": "gte", "value": 3}], "add": 1}]},
      "consequence": {"field": "declared_payable", "bounds": [1, 100000, 500000, 2000000, 10000000]},
      "effort": "low"
    },
    "treatment": "payment_engagement",
    "explanation": "No settled, non-reversed PAYE remittance is allocated to {period} after the effective due date {payment_due_at}. Declared payable: {declared_payable}.",
    "alternative_explanations": ["Remittance made with a wrong reference and sitting unallocated", "Bank settlement delay", "Payment reversed in error"],
    "references": ["SYNTHETIC: state-approved effective-dated PAYE remittance provision (pending NGSIRS legal confirmation)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
    "id": "PAY-002", "version": "1.0.0", "domain": "payment",
    "title": "PAYE remittance received after due date",
