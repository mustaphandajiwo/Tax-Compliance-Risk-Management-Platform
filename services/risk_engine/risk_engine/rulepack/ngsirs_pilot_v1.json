  {
    "id": "PAY-004", "version": "1.0.0", "domain": "payment",
    "title": "Remittance lower than verified declared payable amount",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_REMITTANCE@effective_period",
    "eligibility": ["active_obligation", "accepted_return_exists", "past_payment_due_date"],
    "input_refs": ["return_filing", "declared_amount", "payment", "payment_allocation"],
    "conditions": [
      {"field": "settled_payment_count", "op": "gt", "value": 0},
      {"field": "residual_amount", "op": "gt", "value": 1000}
    ],
    "exclusions": ["payment_coverage_incomplete", "possible_unallocated_receipt", "quarantined_period_records", "source_conflict"],
    "holds": ["legal_hold", "disputed", "reversal_unconfirmed"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["filing", "payment"]},
    "signal": {
      "likelihood": {"base": 3, "adjust": []},
      "consequence": {"field": "residual_amount", "bounds": [1, 50000, 250000, 1000000, 5000000]},
      "effort": "low"
    },
    "treatment": "payment_engagement",
    "explanation": "Settled remittance for {period} is {residual_amount} below the declared payable {declared_payable} after credits and adjustments.",
    "alternative_explanations": ["Credit or adjustment not yet captured", "Balance paid under a separate unallocated receipt"],
    "references": ["SYNTHETIC: state-approved effective-dated PAYE remittance provision (pending NGSIRS legal confirmation)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
