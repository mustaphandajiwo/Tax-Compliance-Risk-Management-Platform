  {
    "id": "PAY-003", "version": "1.0.0", "domain": "payment",
    "title": "Repeated PAYE remittance lateness",
    "signal_class": "taxpayer_risk",
    "scope": {"tax_type": "PAYE", "entity": "employer", "fact_kind": "employer_period"},
    "obligation_ref": "PAYE_EMPLOYER_REMITTANCE@effective_period",
    "eligibility": ["active_obligation"],
    "input_refs": ["period_schedule", "payment", "payment_allocation"],
    "conditions": [
      {"field": "anchor_period", "op": "eq", "value": true},
      {"aggregate": "count", "series": "payment", "window": 6, "where": [{"field": "eligible", "op": "eq", "value": true}, {"field": "late", "op": "eq", "value": true}], "op": "gte", "value": 3}
    ],
    "exclusions": ["ceased_obligation", "bank_delay_dispute", "payment_coverage_incomplete", "source_conflict"],
    "holds": ["legal_hold", "disputed"],
    "quality": {"max_staleness_days": 7, "min_match_confidence": 0.98, "require_coverage": ["payment"]},
    "signal": {"likelihood": {"base": 3, "adjust": []}, "consequence": "unknown", "effort": "medium"},
    "treatment": "payment_engagement",
    "explanation": "PAYE remittance was late in three or more eligible periods of the last six as at {period}.",
    "alternative_explanations": ["Systematic bank posting delay for the employer's bank", "Due date configuration differs from employer's understanding"],
