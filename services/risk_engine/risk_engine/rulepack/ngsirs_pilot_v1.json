  {
    "id": "DAT-001", "version": "1.0.0", "domain": "data_quality",
    "title": "Duplicate NGSIRS taxpayer identities",
    "signal_class": "data_quality",
    "scope": {"tax_type": "PAYE", "entity": "taxpayer", "fact_kind": "taxpayer_pair"},
    "obligation_ref": null,
    "eligibility": [],
    "input_refs": ["taxpayer", "taxpayer_identifier"],
    "conditions": [{"any": [
      {"field": "shared_identifier_count", "op": "gte", "value": 1},
      {"all": [{"field": "name_similarity", "op": "gte", "value": 0.92}, {"field": "same_lga", "op": "eq", "value": true}]}
    ]}],
    "exclusions": [],
    "holds": [],
    "quality": {"max_staleness_days": 30, "min_match_confidence": 0.0, "require_coverage": []},
    "signal": {"likelihood": {"base": 1, "adjust": []}, "consequence": "unknown", "effort": "low"},
    "treatment": "identity_review",
    "explanation": "Two taxpayer records may describe the same entity (shared identifiers: {shared_identifier_count}, name similarity: {name_similarity}). Candidates are never merged automatically.",
    "alternative_explanations": ["Related but legally distinct entities", "Group companies sharing an address"],
    "references": ["NGSIRS registration data standard (internal)"],
    "approval": {"author": "risk_analyst", "checker": "legal_and_risk_manager"}
  },
  {
