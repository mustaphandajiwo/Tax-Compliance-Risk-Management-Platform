    "id": "PAY-101",
    "domain": "payment",
    "title": "Liability unpaid after due date under a revenue head",
    "scope": {
      "tax_type": "*",
      "entity": "account",
      "fact_kind": "account_period"
    },
    "obligation_ref": "*:payment@effective_period",
    "input_refs": [
