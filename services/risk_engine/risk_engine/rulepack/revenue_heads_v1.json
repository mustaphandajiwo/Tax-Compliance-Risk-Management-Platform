    "id": "FIL-101",
    "domain": "filing",
    "title": "Return missing under a revenue head",
    "scope": {
      "tax_type": "*",
      "entity": "account",
      "fact_kind": "account_period"
    },
    "obligation_ref": "*:return@effective_period",
    "input_refs": [
      "revenue_account",
      "revenue_liability"
    ],
    "conditions": [
      {
        "field": "pattern",
        "op": "ne",
        "value": "transaction"
      },
      {
        "field": "filed_count",
        "op": "eq",
        "value": 0
      }
    ],
    "quality": {
      "max_staleness_days": 7,
      "min_match_confidence": 0.98,
      "require_coverage": [
        "filing"
      ]
    },
    "signal": {
      "likelihood": {
        "base": 3,
        "adjust": [
          {
            "when": [
              {
                "aggregate": "count",
                "series": "filing",
                "window": 4,
                "where": [
                  {
                    "field": "missing",
                    "op": "eq",
                    "value": true
                  }
                ],
                "op": "gte",
                "value": 2
              }
            ],
            "add": 1
          }
        ]
      },
      "consequence": "unknown",
      "effort": "low"
    },
    "treatment": "review_then_approved_reminder",
    "explanation": "No {tax_head} return found for {period} after the due date {return_due_at}."
  },
