      },
      {
        "field": "settled_payment_count",
        "op": "eq",
        "value": 0
      }
    ],
    "quality": {
      "max_staleness_days": 7,
      "min_match_confidence": 0.98,
      "require_coverage": [
        "payment"
      ]
    },
    "signal": {
      "likelihood": {
        "base": 3,
        "adjust": [
          {
            "when": [
              {
                "aggregate": "count",
                "series": "payment",
                "window": 4,
                "where": [
                  {
                    "field": "missing",
                    "op": "eq",
                    "value": true
                  }
                ],
                "op": "gte",
                "value": 2
              }
            ],
            "add": 1
          }
        ]
      },
      "consequence": {
        "field": "liability_amount",
        "bounds": [
          1,
          50000,
          250000,
          1000000,
          5000000
        ]
      },
      "effort": "low"
    },
    "treatment": "payment_engagement",
    "explanation": "No settled {tax_head} payment for {period} after the due date {payment_due_at}. Amount due: {liability_amount}."
  },
