{
  "name": "@taxcris/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI contract for the TaxCRIS API and generated TypeScript types.",
  "types": "src/api.d.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/api.d.ts",
    "fetch-spec": "curl -sf ${API_URL:-http://localhost:8000}/openapi.json -o ./openapi.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
