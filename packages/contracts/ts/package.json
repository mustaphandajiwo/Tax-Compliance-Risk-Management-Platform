{
  "name": "@ngsirs/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript types generated from packages/contracts/openapi.json and a typed openapi-fetch client",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
