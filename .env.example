# Copy to .env for local overrides. Values below are local-development defaults only.
NGSIRS_ENVIRONMENT=demo
NGSIRS_DATABASE_URL=postgresql+psycopg://ngsirs_app:ngsirs_app@127.0.0.1:5432/ngsirs
NGSIRS_OWNER_DATABASE_URL=postgresql+psycopg://ngsirs_owner:ngsirs_owner@127.0.0.1:5432/ngsirs
NGSIRS_STORAGE_PATH=.data/objects
# Production: set NGSIRS_ENVIRONMENT=production, NGSIRS_DEV_AUTH_ENABLED=false, NGSIRS_REQUIRE_MFA=true,
# NGSIRS_OIDC_JWKS_URL / NGSIRS_OIDC_ISSUER / NGSIRS_OIDC_AUDIENCE, and inject NGSIRS_DATA_KEY_B64,
# NGSIRS_TOKEN_KEY_B64 and key files from the state vault. The API refuses to start otherwise.
