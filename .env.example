# Copy to .env for local overrides. Values below are local-development defaults only.
TAXRISK_ENVIRONMENT=demo
TAXRISK_DATABASE_URL=postgresql+psycopg://taxrisk_app:taxrisk_app@127.0.0.1:5432/taxrisk
TAXRISK_OWNER_DATABASE_URL=postgresql+psycopg://taxrisk_owner:taxrisk_owner@127.0.0.1:5432/taxrisk
TAXRISK_STORAGE_PATH=.data/objects
# Production: set TAXRISK_ENVIRONMENT=production, TAXRISK_DEV_AUTH_ENABLED=false, TAXRISK_REQUIRE_MFA=true,
# TAXRISK_OIDC_JWKS_URL / TAXRISK_OIDC_ISSUER / TAXRISK_OIDC_AUDIENCE, and inject TAXRISK_DATA_KEY_B64,
# TAXRISK_TOKEN_KEY_B64 and key files from the state vault. The API refuses to start otherwise.
