FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY apps/api/pyproject.toml apps/api/README.md* ./apps/api/
COPY apps/api/taxcris ./apps/api/taxcris
COPY apps/api/alembic ./apps/api/alembic
COPY apps/api/alembic.ini ./apps/api/
COPY fixtures/synthetic ./fixtures/synthetic
COPY workers ./workers
RUN pip install --no-cache-dir ./apps/api && useradd --system --uid 10001 taxcris
USER taxcris
WORKDIR /srv/apps/api
EXPOSE 8000
CMD ["uvicorn", "taxcris.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
